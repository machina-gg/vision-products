---
interface Props {
  product: string;
  label: string;
  href?: string;
}

const { product, label, href } = Astro.props;
---

{href
  ? <a href={href} class={`tag-badge tag-badge--${product}`}>{label}</a>
  : <span class={`tag-badge tag-badge--${product}`}>{label}</span>
}

<style>
  .tag-badge {
    display: inline-block;
    padding: 0.125rem 0.625rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    border: 1px solid var(--sl-color-accent);
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease;
    white-space: nowrap;
  }

  .tag-badge:hover {
    background: var(--sl-color-accent);
    color: white;
  }
</style>
