---
interface DownloadLink {
  label: string;
  href: string;
  type: 'appstore' | 'googleplay' | 'direct' | 'chrome';
  isPrimary?: boolean;
}

interface Props {
  links: DownloadLink[];
}

const { links } = Astro.props;

const isExternal = (href: string) => href.startsWith('http');

const ICON_SVG: Record<DownloadLink['type'], string> = {
  chrome: `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.5"/>
    <circle cx="8" cy="8" r="2" fill="currentColor"/>
    <path d="M8 2v3.5M13.5 5.25L10.5 7M13.5 10.75L10.5 9M8 14v-3.5M2.5 10.75L5.5 9M2.5 5.25L5.5 7" stroke="currentColor" stroke-width="1.25"/>
  </svg>`,
  direct: `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <rect x="2.5" y="1.5" width="11" height="13" rx="1" stroke="currentColor" stroke-width="1.5"/>
    <path d="M5 6h6M5 9h6M5 12h3" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
  </svg>`,
  appstore: `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M11.5 1C10.5 1 9.5 2 8 2S5.5 1 4.5 1C2.5 1 1 3 1 5.5 1 9 3.5 15 5.5 15c.8 0 1.5-.5 2.5-.5S10.2 15 11 15c2 0 4.5-6 4.5-9.5C15.5 3 14 1 11.5 1z" stroke="currentColor" stroke-width="1.25" stroke-linejoin="round"/>
    <path d="M8 1C8 1 7.5 3 6 4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
  </svg>`,
  googleplay: `<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path d="M3 1.5L13.5 8 3 14.5V1.5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
  </svg>`,
};
---

<div class="download-buttons">
  {links.map((link, i) => (
    <a
      href={link.href}
      class={`download-btn download-btn--${link.type}${(link.isPrimary || i === 0) ? ' download-btn--primary' : ''}`}
      {...(isExternal(link.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
    >
      <span class="download-btn-icon">
        <Fragment set:html={ICON_SVG[link.type]} />
      </span>
      <span class="download-btn-label">{link.label}</span>
    </a>
  ))}
</div>

<style>
  .download-buttons {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .download-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6875rem 1.375rem;
    border-radius: 0.625rem;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  /* Primary: filled gradient */
  .download-btn--primary {
    background: linear-gradient(135deg, #14B8A6, #0d9488);
    color: white;
    box-shadow: 0 4px 16px rgba(20, 184, 166, 0.3);
  }

  .download-btn--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(20, 184, 166, 0.4);
    color: white;
  }

  /* Non-primary: glass outline */
  .download-btn:not(.download-btn--primary) {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.75);
    backdrop-filter: blur(8px);
  }

  .download-btn:not(.download-btn--primary):hover {
    background: rgba(255, 255, 255, 0.09);
    border-color: rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.95);
  }

  .download-btn-icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }
</style>
