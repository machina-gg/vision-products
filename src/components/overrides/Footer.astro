---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="site-footer-top">
      <!-- Brand -->
      <div class="site-footer-brand">
        <a href="/" class="site-footer-logo">Vision Products</a>
        <p class="site-footer-tagline">
          集中力・生産性・デジタルウェルビーイングのためのアプリとツールを作っています。
        </p>
        <div class="site-footer-social">
          <a
            href="https://github.com/machina-gg"
            class="site-footer-social-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Links -->
      <div class="site-footer-links">
        <div class="site-footer-col">
          <h3 class="site-footer-col-title">Products</h3>
          <ul class="site-footer-col-links">
            <li><a href="/vision-focus/">VisionFocus</a></li>
          </ul>
        </div>

        <div class="site-footer-col">
          <h3 class="site-footer-col-title">VisionFocus</h3>
          <ul class="site-footer-col-links">
            <li><a href="/docs/vision-focus/getting-started/">はじめかた</a></li>
            <li><a href="/docs/vision-focus/blocking-websites/">ウェブサイトブロック</a></li>
            <li><a href="/docs/vision-focus/timers/">タイマー機能</a></li>
            <li><a href="/docs/vision-focus/faq/">FAQ</a></li>
          </ul>
        </div>

        <div class="site-footer-col">
          <h3 class="site-footer-col-title">Legal</h3>
          <ul class="site-footer-col-links">
            <li><a href="/legal/privacy/">プライバシーポリシー</a></li>
            <li><a href="/legal/terms/">利用規約</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div class="site-footer-bottom">
      <p class="site-footer-copy">
        &copy; {currentYear} machina.gg — All rights reserved.
      </p>
      <p class="site-footer-built">
        Built with
        <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
        &amp;
        <a href="https://starlight.astro.build" target="_blank" rel="noopener noreferrer">Starlight</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: color-mix(in srgb, var(--sl-color-bg-nav) 95%, transparent);
    border-top: 1px solid color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
    margin-top: 4rem;
  }

  .site-footer-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 2rem;
  }

  .site-footer-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 3rem;
    margin-bottom: 2.5rem;
  }

  @media (max-width: 768px) {
    .site-footer-top {
      grid-template-columns: 1fr 1fr;
    }

    .site-footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 480px) {
    .site-footer-top {
      grid-template-columns: 1fr;
    }
  }

  .site-footer-logo {
    display: inline-block;
    font-size: 1rem;
    font-weight: 700;
    color: var(--sl-color-white);
    text-decoration: none;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .site-footer-tagline {
    font-size: 0.8125rem;
    color: var(--vp-text-muted);
    line-height: 1.7;
    margin: 0 0 1.25rem;
    max-width: 22rem;
  }

  .site-footer-social {
    display: flex;
    gap: 0.625rem;
  }

  .site-footer-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: 0.5rem;
    color: var(--vp-text-muted);
    background: color-mix(in srgb, var(--sl-color-accent) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 15%, transparent);
    transition: color 0.15s ease, background 0.15s ease;
    text-decoration: none;
  }

  .site-footer-social-link:hover {
    color: var(--sl-color-accent);
    background: color-mix(in srgb, var(--sl-color-accent) 15%, transparent);
  }

  .site-footer-links {
    display: contents;
  }

  .site-footer-col-title {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--sl-color-accent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 1rem;
  }

  .site-footer-col-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .site-footer-col-links a {
    font-size: 0.875rem;
    color: var(--vp-text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .site-footer-col-links a:hover {
    color: var(--sl-color-accent);
  }

  .site-footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--sl-color-hairline) 60%, transparent);
    gap: 1rem;
    flex-wrap: wrap;
  }

  .site-footer-copy,
  .site-footer-built {
    font-size: 0.8125rem;
    color: var(--vp-text-muted);
    margin: 0;
  }

  .site-footer-built a {
    color: var(--vp-text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .site-footer-built a:hover {
    color: var(--sl-color-accent);
  }
</style>
